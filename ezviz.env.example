# ====================================================
# 萤石云转 ONVIF 网关环境变量配置
# ====================================================

# 鉴权模式: "open" (推荐, 走萤石开放平台官方通道) 或 "app" (走移动端账号Token通道)
AUTH_MODE=open

# 1. 萤石开放平台凭证 (AUTH_MODE=open 时使用)
# 获取方式: 登录 https://open.ys7.com (用萤石APP同一手机号登录) -> 控制台 -> 应用信息
APP_KEY=your_app_key_here
APP_SECRET=your_app_secret_here

# 2. 移动端 App Token (AUTH_MODE=app 时可选)
# APP_SSID=at.xxxxx
# APP_ACCOUNT=13800000000
# APP_PASSWORD=your_password

# 画质设置: hd (高清, 推荐) 或 sd (标清)
QUALITY=hd

# 协议: rtsp
PROTOCOL=rtsp

# 是否同步离线设备 (0: 否, 1: 是)
INCLUDE_OFFLINE=0

# 输出配置文件位置
OUTPUT=/opt/ezviz2onvif/go2rtc.yaml
TOKEN_CACHE=/opt/ezviz2onvif/token.json
